# ForestGuard Backend Environment Configuration
# Copy this file to .env to override default parameters

PORT=8000
HOST=0.0.0.0

# Alert Threshold Defaults
DEFAULT_TEMP_THRESHOLD=50.0
DEFAULT_MQ2_THRESHOLD=400
DEFAULT_DEBOUNCE_SAMPLES=3
STALE_TIMEOUT_SEC=5.0

# Hardware Serial Configuration
DEFAULT_SERIAL_PORT=AUTO
DEFAULT_SERIAL_BAUD=115200

# Push Notifications (ntfy / Webhook)
NOTIFICATIONS_ENABLED=false
NOTIFICATION_PROVIDER=ntfy
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=forestguard-alerts-demo
WEBHOOK_URL=
